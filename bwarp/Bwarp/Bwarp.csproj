<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bwarp</RootNamespace>
    <!-- NuGet 打包（元数据继承自根 Directory.Build.props）。程序集名仍为 Bwarp。 -->
    <PackageId>ManInBlack.Bwarp</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Linux bubblewrap (bwrap) 沙盒封装：白名单挂载、能力控制与命令执行，ManInBlack 的命令沙盒层。</Description>
    <PackageTags>sandbox;bubblewrap;bwrap;linux</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
